{
  "description": "VGV FFCA plugin hooks: syncs Very Good Engineering standards at session start, enforces Feature-First Clean Architecture layer rules on pubspec.yaml and Dart edits, and gates Very Good CLI MCP tool calls",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sync-vge-standards.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^vgv-ffca-plugin:ffca-layer-auditor$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sync-vge-standards.sh\" --subagent",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*very-good-cli__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check_vgv_cli.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/validate_layers.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
