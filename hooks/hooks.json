{
  "description": "VGV FFCA plugin hook: enforces Feature-First Clean Architecture layer rules on pubspec.yaml edits",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/validate_layers.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
